<Project>
	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
		<GlobalVersion>0.2.1</GlobalVersion>
		<GlobalCompany>Maksim Shimshon</GlobalCompany>
		<GlobalAuthors>Maksim Shimshon</GlobalAuthors>
		<GlobalCopyright>Maksim Shimshon © 2026</GlobalCopyright>
		<PanelVersion>0.2.101</PanelVersion>
		<DotnetVersion>10.0.12</DotnetVersion>
		<MudBlazor>9.11.0</MudBlazor>
	</PropertyGroup>
	<ItemGroup>
		<PackageVersion Include="LunaticPanel.Core" Version="$(PanelVersion)" />
		<PackageVersion Include="LunaticPanel.Core.Abstraction" Version="$(PanelVersion)" />
		<PackageVersion Include="LunaticPanel.Core.Extensions" Version="$(PanelVersion)" />
		<PackageVersion Include="LunaticPanel.Core.Utils" Version="$(PanelVersion)" />
		<PackageVersion Include="LunaticPanel.Core.Utils.Abstraction" Version="$(PanelVersion)" />
		<PackageVersion Include="LunaticPanel.Engine.Keys" Version="$(PanelVersion)" />
		<PackageVersion Include="Microsoft.AspNetCore.Components" Version="$(DotnetVersion)" />
		<PackageVersion Include="Microsoft.Extensions.FileProviders.Physical" Version="10.0.5" />
		<PackageVersion Include="Microsoft.Extensions.Logging" Version="$(DotnetVersion)" />
		<PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.1" />
		<PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="$(DotnetVersion)" />
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(DotnetVersion)" />
		<PackageVersion Include="MudBlazor" Version="$(MudBlazor)"  />
		<PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageVersion Include="StatePulse.Net" Version="3.1.0" />
		<PackageVersion Include="StatePulse.Net.Abstractions" Version="3.1.0" />
		<PackageVersion Include="MediHater" Version="1.0.1" />
		<PackageVersion Include="CoreMap" Version="1.1.2" />
		<PackageVersion Include="Octokit" Version="14.0.0" />
	</ItemGroup>
</Project>